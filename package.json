{
  "name": "@zhiliangtech/agentgate",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "mcpName": "io.github.ciceroyang/agentgate",
  "description": "Control plane for the tools agents run. Inventory, evidence, policy, enforcement. Clean is only emitted when every check ran.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:package": "node scripts/pack-release.mjs",
    "test": "node --test test/*.test.mjs packages/guard/test/*.test.mjs packages/guard/test/invariant.mjs packages/collect/test/*.test.mjs packages/policy/test/*.test.mjs packages/history/test/*.test.mjs packages/gateway/test/*.test.mjs packages/service/test/*.test.mjs packages/verify/test/*.test.mjs packages/watch/test/*.test.mjs packages/backup/test/*.test.mjs packages/mcp/test/*.test.mjs packages/pack/test/*.test.mjs packages/release/test/*.test.mjs",
    "test:guard": "node --test packages/guard/test/*.test.mjs packages/guard/test/invariant.mjs",
    "test:collect": "node --test packages/collect/test/*.test.mjs",
    "test:verify": "node --test packages/verify/test/*.test.mjs",
    "regression": "node packages/guard/scripts/regression.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "serve": "node bin/agentgate.mjs serve",
    "refresh": "node bin/agentgate.mjs refresh"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentgate": "./bin/agentgate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ciceroyang/agentgate.git"
  },
  "homepage": "https://github.com/ciceroyang/agentgate",
  "bugs": {
    "url": "https://github.com/ciceroyang/agentgate/issues"
  },
  "keywords": [
    "mcp",
    "agent-security",
    "supply-chain",
    "policy",
    "sbom",
    "sarif"
  ],
  "author": "ciceroyang",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin/",
    "packages/",
    "data/sample-index.json",
    "site/inventory.html",
    "site/inventory-page.mjs",
    "site/favicon.svg",
    "examples/inventory/",
    "docs/spec/",
    "docs/roadmap.md",
    "docs/operations/upgrade.md",
    "docs/operations/README.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "server.json",
    "LICENSE"
  ]
}
